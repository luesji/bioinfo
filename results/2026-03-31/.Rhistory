# 1. Ajustamos márgenes (abajo, izquierda, arriba, derecha) para dar espacio a los textos largos
par(mar = c(8, 2, 2, 8))
# 2. Dibujamos el árbol con texto MUY pequeño (cex=0.5) y sin los bordes por defecto
plot(mt_nj, cex = 0.5, no.margin = TRUE)
# 3. Añadimos SOLO el eje inferior para medir distancias
axisPhylo(side = 1)
add.scale.bar()
# 1. Ajustamos márgenes (abajo, izquierda, arriba, derecha) para dar espacio a los textos largos
par(mar = c(10, 2, 2, 8))
# 2. Dibujamos el árbol con texto MUY pequeño (cex=0.5) y sin los bordes por defecto
plot(mt_nj, cex = 0.5, no.margin = TRUE)
# 3. Añadimos SOLO el eje inferior para medir distancias
axisPhylo(side = 1)
add.scale.bar()
# 1. Limpiar márgenes: damos mucho espacio a la derecha (8) para los nombres
# y espacio abajo (5) para que el eje no se corte.
par(mar = c(5, 1, 1, 8))
# 2. Dibujar el árbol.
# 'x.lim' ayuda a que el árbol no ocupe toda la pantalla y deje sitio a los nombres.
plot(mt_nj, cex = 0.6, x.lim = 0.15)
# 3. Añadir el eje de forma limpia.
# 'side = 1' lo pone abajo.
axisPhylo(side = 1)
is.rooted(mt_nj)

# OBS_CT no es categórica, pero la tratamos como tal con "factor()".
# Observa que el color aquí se mapea sólo en la capa "geom_smooth()",
# para que los puntos sean todos negros.
ggplot(data = gwas,
mapping = aes(x = A1_FREQ, y = SE)) +
geom_point(mapping = aes(color = factor(OBS_CT)), scale_color_viridis_d(), se = FALSE) +
geom_smooth(mapping = aes(color = factor(OBS_CT)), se = FALSE)
ggplot(data = gwas, mapping = aes(x = A1_FREQ, y = SE, group = factor(OBS_CT))) +
# Usamos shape = 21 (círculo con borde y relleno)
geom_point(aes(fill = factor(OBS_CT)), shape = 21, color = "white", alpha = 0.5) +
geom_smooth(aes(color = factor(OBS_CT)), se = FALSE, linewidth = 1.2) +
# Definimos las dos paletas
scale_fill_brewer(palette = "Set3") +   # Paleta para los puntos
scale_color_brewer(palette = "Set1") +  # Paleta para las líneas
labs(title = "Relación Frecuencia vs SE",
fill = "N (Puntos)",
color = "N (Líneas)") +
theme_minimal()
